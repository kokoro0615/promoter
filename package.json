{
  "name": "nightclub-app",
  "private": true,
  "version": "0.1.0",
  "description": "Nightclub v4 R1 - referrer/entrance management SaaS (isolated development implementation)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "devdb:start": "node tools/devdb.mjs start",
    "devdb:stop": "node tools/devdb.mjs stop",
    "devdb:status": "node tools/devdb.mjs status",
    "db:migrate": "tsx tools/migrate.ts",
    "db:seed": "tsx tools/seed.ts",
    "db:reset": "tsx tools/migrate.ts --reset",
    "db:backup": "node tools/backup.mjs backup",
    "db:restore": "node tools/backup.mjs restore",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit -p tsconfig.json",
    "openapi:lint": "redocly lint spec/current/openapi.yaml",
    "verify": "pnpm lint && pnpm test:unit && pnpm test:db && pnpm test:api"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "argon2": "0.45.1",
    "fastify": "5.12.4",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.53.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
