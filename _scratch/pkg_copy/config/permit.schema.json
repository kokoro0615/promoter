{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightclub:v4:permit",
  "title": "顧客／登録者事前許可の内容",
  "type": "object",
  "properties": {
    "subject_kind": {
      "type": "string",
      "enum": [
        "CUSTOMER",
        "ACTOR"
      ]
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "store_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "allowed_rule_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "party_limit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "UNSET",
            "LIMITED",
            "UNLIMITED"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIMITED"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "event_limit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "UNSET",
            "LIMITED",
            "UNLIMITED"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIMITED"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "companion_limit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "UNSET",
            "LIMITED",
            "UNLIMITED"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIMITED"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "principal_presence_required": {
      "type": "boolean"
    },
    "proxy_registration_allowed": {
      "type": "boolean"
    },
    "proxy_referrer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "subject_kind",
    "subject_id",
    "store_id",
    "event_ids",
    "allowed_rule_keys",
    "valid_from",
    "valid_to",
    "party_limit",
    "event_limit",
    "companion_limit",
    "principal_presence_required",
    "proxy_registration_allowed",
    "proxy_referrer_ids",
    "reason"
  ],
  "additionalProperties": false
}
