erDiagram
    %% v4 R1 physical reference. Composite tenant/store/event FKs are defined in model.json.
    devices {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        text status
        uuid enrolled_by FK
        bigint operator_epoch
        integer version
    }
    device_enrollments {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid device_id FK
        uuid issued_by FK
        integer version
    }
    device_sessions {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid device_id FK
        integer version
    }
    operator_credentials {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid membership_id FK
        integer version
    }
    operator_sessions {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid event_id FK
        uuid device_id FK
        uuid device_session_id FK
        uuid membership_id FK
        bigint operator_epoch
        integer version
    }
    memberships {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid user_id FK
        text status
        integer version
    }
    events {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        text status
        integer version
    }
    memberships ||..o{ devices : enrolled_by
    devices ||..o{ device_enrollments : device_id
    memberships ||..o{ device_enrollments : issued_by
    devices ||..o{ device_sessions : device_id
    memberships ||..o{ operator_credentials : membership_id
    devices ||..o{ operator_sessions : device_id
    device_sessions ||..o{ operator_sessions : device_session_id
    memberships ||..o{ operator_sessions : membership_id
    device_sessions |o..o{ operator_sessions : same_device_session
