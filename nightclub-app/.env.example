# Nightclub v4 app environment (names only - never commit values)
# Database: local devdb is auto-managed; set PG* for external DB
DATABASE_URL=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# DevDB socket dir (local embedded postgres)
DEVDB_DIR=
# Auth
DEV_AUTH_ENABLED=false
