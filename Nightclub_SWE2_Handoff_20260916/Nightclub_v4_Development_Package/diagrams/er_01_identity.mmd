erDiagram
    %% v4 R1 physical reference. Composite tenant/store/event FKs are defined in model.json.
    tenants {
        uuid id PK
        text status
        integer version
    }
    app_users {
        uuid id PK
        text status
        integer version
    }
    external_identities {
        uuid id PK
        uuid user_id FK
        integer version
    }
    auth_sessions {
        uuid id PK
        uuid user_id FK
        integer version
    }
    stores {
        uuid id PK
        uuid tenant_id FK
        text status
        integer version
    }
    memberships {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid user_id FK
        text status
        integer version
    }
    roles {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        integer version
    }
    role_permissions {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid role_id FK
        integer version
    }
    membership_roles {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid membership_id FK
        uuid role_id FK
        uuid granted_by FK
        integer version
    }
    invitation_tokens {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid role_id FK
        uuid issued_by FK
        uuid used_by FK "nullable"
        integer version
    }
    event_assignments {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid event_id FK
        uuid membership_id FK
        integer version
    }
    referrer_profiles {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        uuid membership_id FK
        integer version
    }
    events {
        uuid id PK
        uuid tenant_id FK
        uuid store_id FK
        text status
        integer version
    }
